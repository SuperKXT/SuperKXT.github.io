---
import Layout from "../layouts/Layout.astro";
const pattern = Array.from({ length: 5 }, (_, idx) => idx + 1);
---

<Layout title="Wordle Finder">
  <main>
    <header>
      <h1>Wordle Finder</h1>
    </header>

    <div id="results"></div>

    <form id="wordle-form">
      <div id="pattern">
        {
          pattern.map((p) => (
            <div class="char-wrapper">
              <button type="button" class="arrow up">
                ▲
              </button>
              <input id={`char-${p}`} />
              <button type="button" class="arrow down">
                ▼
              </button>
            </div>
          ))
        }
      </div>

      <div id="unavailable-container">
        <label for="unavailable">Unavailable</label>
        <input id="unavailable" name="unavailable" />
      </div>

      <hr />

      <div id="keyboard">
        <div class="row">
          <div id="Q">Q</div>
          <div id="W">W</div>
          <div id="E">E</div>
          <div id="R">R</div>
          <div id="T">T</div>
          <div id="Y">Y</div>
          <div id="U">U</div>
          <div id="I">I</div>
          <div id="O">O</div>
          <div id="P">P</div>
        </div>
        <div class="row">
          <div id="A">A</div>
          <div id="S">S</div>
          <div id="D">D</div>
          <div id="F">F</div>
          <div id="G">G</div>
          <div id="H">H</div>
          <div id="J">J</div>
          <div id="K">K</div>
          <div id="L">L</div>
        </div>
        <div class="row">
          <div id="Z">Z</div>
          <div id="X">X</div>
          <div id="C">C</div>
          <div id="V">V</div>
          <div id="B">B</div>
          <div id="N">N</div>
          <div id="M">M</div>
        </div>
      </div>

      <button id="find">Find</button>
    </form>
  </main>
</Layout>

<script>
  import { findWordle } from "../wordle/wordle.ts";

  const keys = document.querySelectorAll<HTMLDivElement>(
    "#keyboard > .row > div",
  );
  const inputs = document.querySelectorAll<HTMLInputElement>("#pattern input");

  const inputMap = new Map<string, HTMLInputElement>();
  const keyMap = new Map<string, HTMLDivElement>();

  keys.forEach((key) => {
    keyMap.set(key.id, key);
  });

  const unavailable = document.querySelector<HTMLInputElement>("#unavailable");

  const updateKeyStatus = (key: string): void => {
    const curr = keyMap.get(key);
    if (!curr) return;
    let status = "";
    for (const input of inputMap.values()) {
      if (input.value !== key) continue;
      status = input.className;
      if (status === "right") break;
    }
    if (status === "" && unavailable?.value.toUpperCase().includes(key)) {
      status = "unavailable";
    }
    curr.className = status;
  };

  const removeFromUnavailable = (letter: string): void => {
    if (!unavailable) return;
    const updated = unavailable.value.replace(letter.toUpperCase(), "");
    if (updated === unavailable.value) return;
    unavailable.value = updated;
    unavailable.className = updated.length > 0 ? "unavailable" : "";
  };

  keys.forEach((key) => {
    key.addEventListener("click", () => {
      if (!unavailable) return;
      if (key.className === "right" || key.className === "wrong") return;
      const letter = key.id;
      const current = unavailable.value;
      if (current.includes(letter)) {
        unavailable.value = current.replace(letter, "");
      } else {
        if (current.length >= 26) return;
        unavailable.value = current + letter;
      }
      unavailable.className = unavailable.value.length > 0 ? "unavailable" : "";
      keyMap.forEach((_, k) => updateKeyStatus(k));
    });
  });

  inputs.forEach((input) => {
    inputMap.set(input.id, input);
    input.addEventListener("keydown", (e) => {
      const key = e.key.toUpperCase();
      const prevKey = input.value;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        const prev = input
          .closest(".char-wrapper")
          ?.previousElementSibling?.querySelector("input");
        if (prev instanceof HTMLInputElement) prev.focus();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        const next = input
          .closest(".char-wrapper")
          ?.nextElementSibling?.querySelector("input");
        if (next instanceof HTMLInputElement) next.focus();
      } else if (e.key === "ArrowUp" || e.key === "ArrowDown") {
        e.preventDefault();
        if (keyMap.has(prevKey)) {
          input.className = input.className === "wrong" ? "right" : "wrong";
          removeFromUnavailable(prevKey);
          updateKeyStatus(prevKey);
        }
      } else if (e.key === "Backspace") {
        e.preventDefault();
        input.value = "";
        input.className = "";
        updateKeyStatus(prevKey);
      } else if (keyMap.has(key)) {
        e.preventDefault();
        if (key === prevKey) return;
        input.value = key;
        input.className = "right";
        removeFromUnavailable(key);
        updateKeyStatus(key);
        updateKeyStatus(prevKey);
      }
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>("#pattern .arrow")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = btn
          .closest(".char-wrapper")
          ?.querySelector<HTMLInputElement>("input");
        if (!input) return;
        const val = input.value;
        if (!keyMap.has(val)) return;
        input.className = input.className === "wrong" ? "right" : "wrong";
        removeFromUnavailable(val);
        updateKeyStatus(val);
      });
    });

  unavailable?.addEventListener("input", (_ev) => {
    let value = unavailable.value.toUpperCase().replace(/[^A-Z]/g, "");
    if (value.length > 26) return;
    value = [...value]
      .filter((letter) => {
        const cls = keyMap.get(letter)?.className;
        return cls !== "right" && cls !== "wrong";
      })
      .join("");
    unavailable.value = value;
    unavailable.className = value.length > 0 ? "unavailable" : "";
    keyMap.forEach((_, key) => updateKeyStatus(key));
  });

  const results = document.getElementById("results");

  const form = document.getElementById("wordle-form");
  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const active = document.activeElement as HTMLElement | null;
      active?.blur();

      let pattern = "";
      const known: string[] = [];
      for (const input of inputMap.values()) {
        if (input.className === "right" && input.value) {
          pattern += input.value.toLowerCase();
        } else if (input.className === "wrong" && input.value) {
          pattern += `(${input.value.toLowerCase()})`;
          known.push(input.value.toLowerCase());
        } else {
          pattern += "*";
        }
      }

      const words = findWordle({
        pattern,
        known: known.join(""),
        unavailable: unavailable?.value.toLowerCase() ?? "",
      });

      if (!results) return;
      results.innerHTML = "";
      for (const word of words) {
        const el = document.createElement("div");
        el.textContent = word.toUpperCase();
        el.addEventListener("click", () => {
          const text = word.toUpperCase();
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text);
          } else {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            document["execCommand"]("copy");
            document.body.removeChild(ta);
          }
          el.classList.add("copied");
          setTimeout(() => el.classList.remove("copied"), 800);
        });
        results.appendChild(el);
      }
      active?.focus();
    });
  }
</script>

<style>
  main {
    display: flex;
    flex-direction: column;
    padding: 10px;
    padding-bottom: max(10px, env(safe-area-inset-bottom));
    gap: var(--spacing-3);
    width: 100%;
    height: 100dvh;
  }

  #wordle-form {
    display: contents;
  }

  #keyboard {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--spacing-2);

    & > .row {
      display: flex;
      gap: var(--spacing-2);
      flex-wrap: nowrap;

      @media (max-width: 475px) {
        & > :global(div) {
          height: 25px;
          width: 25px;
        }
      }
    }
  }

  #pattern {
    display: flex;
    gap: var(--spacing-2);
    justify-content: center;
    align-items: center;
  }

  #pattern,
  #unavailable-container {
    & > :global(input) {
      &:global(:hover),
      &:global(:focus) {
        outline-width: 2px;
        outline-offset: 5px;
      }

      &:active {
        transform: scale(0.9);
      }
    }
  }

  #pattern > :global(.char-wrapper) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
  }

  #pattern :global(.arrow) {
    all: unset;
    cursor: pointer;
    font-size: 0.8em;
    color: var(--fg);
    line-height: 1;
    padding: 1px 4px;
    border-radius: 3px;
    padding: 5px;
    aspect-ratio: 1;
    display: flex;
    justify-content: center;
    align-items: center;

    &:hover,
    &:focus {
      background-color: var(--highlight-bg);
      color: var(--highlight-fg);
    }
  }

  #unavailable-container {
    width: 350px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    justify-content: center;
    align-items: stretch;
    margin-inline: auto;

    & > label {
      font-weight: 900;
      text-align: center;
    }

    & > #unavailable {
      width: 100%;
    }
  }

  .row > :global(div),
  #pattern :global(input),
  #unavailable {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 900;
    font-size: 1.25em;
    height: 50px;
    width: 50px;
    border: 2px solid var(--border-color);
    border-radius: 5px;
    outline-style: solid;
    outline-color: var(--fg-3);
    outline-width: 0px;
    outline-offset: 0px;
    text-align: center;
    background-color: var(--bg);
    color: var(--fg);

    &.right {
      background-color: var(--success-bg);
      color: var(--success-fg);
    }

    &.wrong {
      background-color: var(--warning-bg);
      color: var(--warning-fg);
    }

    &.unavailable {
      background-color: var(--error-bg);
      color: var(--error-fg);
    }

    &:global(:hover),
    &:global(:focus) {
      outline-width: 2px;
      outline-offset: 5px;
    }

    &:active {
      transform: scale(0.9);
    }
  }

  .row > :global(div) {
    background-color: var(--success-light-bg);
    cursor: pointer;
  }

  @keyframes tooltip-up {
    0% {
      translate: -50% 0;
    }
    100% {
      translate: -50% -5px;
    }
  }

  #results {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    justify-content: center;
    align-items: center;
    align-content: center;
    flex: 1;
    overflow: auto;

    & > :global(div) {
      font-weight: 900;
      font-size: 1em;
      padding: var(--spacing-1) var(--spacing-2);
      border: 2px solid var(--border-color);
      border-radius: 5px;
      background-color: var(--success-bg);
      color: var(--success-fg);
      letter-spacing: 0.1em;
      cursor: pointer;
      position: relative;

      &:hover {
        background-color: var(--success-light-bg);
      }

      &:global(.copied)::before {
        content: "Copied!";
        position: absolute;
        bottom: calc(100% + 5px);
        left: 50%;
        translate: -50% 0;
        font-size: 0.72em;
        font-weight: 900;
        white-space: nowrap;
        background-color: var(--success-light-bg);
        color: var(--fg);
        padding: 3px 6px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        pointer-events: none;
        animation: tooltip-up 0.2s ease-out forwards;
      }
    }
  }

  #find {
    all: unset;
    box-sizing: border-box;
    background-color: var(--error-bg);
    text-align: center;
    font-weight: 900;
    width: 350px;
    height: 50px;
    max-width: 100%;
    margin-inline: auto;
    color: var(--error-color);
    border: 2px solid currentColor;
    padding: var(--spacing-2);
    border-radius: 5px;
    text-transform: uppercase;
    cursor: pointer;
    outline-style: solid;
    outline-color: currentColor;
    outline-width: 0px;
    outline-offset: 0px;

    &:global(:hover),
    &:global(:focus) {
      outline-width: 2px;
      outline-offset: 5px;
    }
  }
</style>
